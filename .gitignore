*.egg-info/
dist/
build/

# Docker
# ignore images/tars if you ever store locally
*.tar
docker-compose.override.yml


# Terraform

# Local state
infra/terraform/terraform.tfstate
infra/terraform/terraform.tfstate.backup
# Crash log
crash.log
# Module directories
infra/terraform/.terraform/
# CLI config
*.tfvars
# Override files
override.tf
override.tf.json
*_override.tf
# Sensitive override
terraform.tfvars


# Helm
# Helm chart archives
**/*.tgz
# Rendered manifests (if you keep them)
**/rendered.yaml
# Local test output
**/helmfile.d/
# Chart lock (if you don’t want to commit)
# Chart.lock


# Kubernetes
# Local kubeconfig overrides
.kube/

# Logs and databases
*.log
*.sql
*.sqlite

# Misc
*.bak
*.orig
